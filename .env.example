OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret word you choose; enter the same word in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=skyline-verify
# Optional: App Settings > Basic > App secret
WHATSAPP_APP_SECRET=

# Optional: used by the bot to link to listings
SITE_URL=
PORT=4500
